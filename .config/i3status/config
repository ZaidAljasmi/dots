general {
    output_format = "i3bar"
    colors = false
    interval = 1
}

order += "load"
order += "cpu_temperature 0"
order += "memory"
order += "volume master"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "tztime local"

load {
    format = "CPU %1min - "
    separator_block_width = 0
    separator = false
}

cpu_temperature 0 {
    format = "%degrees°C"
    separator_block_width = 20
}

memory {
    format = "RAM %used"
    #format = "RAM %percentage_used"
    decimals = 1
    separator_block_width = 20
}

volume master {
    format = "Vol %volume"
    format_muted = "Vol muted"
    separator_block_width = 20
}

wireless _first_ {
    format_up = "Net up"
    format_down = "Net down"
    separator_block_width = 20
}

battery all {
    format = "Bat %percentage%status"
    integer_battery_capacity = true
    last_full_capacity = true
    status_bat = ""
    status_chr = " +"
    status_full = "o"
    status_unk = ""
    separator_block_width = 20
}

tztime local {
    format = "%a %d %b - %I:%M %p "
}
