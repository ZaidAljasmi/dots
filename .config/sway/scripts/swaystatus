#!/bin/sh

get_cpu_freq() {
    if [ -f "/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq" ]; then
        freq_khz=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq)
        freq_ghz=$(awk "BEGIN {printf \"%.1f\", $freq_khz / 1000000}")
        echo "${freq_ghz}"
    else
        echo "N/A"
    fi
}

get_volume() {
    vol_info=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    if [ -z "$vol_info" ]; then
        echo "Vol: N/A"
        return
    fi

    case "$vol_info" in
        *[MUTED]*)
            echo "Vol muted"
            ;;
        *)
            vol_val=$(echo "$vol_info" | awk '{print $2 * 100}')
            echo "Vol: ${vol_val}%"
            ;;
    esac
}

get_network_status() {
    net_status="Net down"
    
    for interface in /sys/class/net/*; do
        if [ -d "$interface" ] && [ "${interface##*/}" != "lo" ]; then
            if [ -f "$interface/operstate" ]; then
                state=$(cat "$interface/operstate")
                if [ "$state" = "up" ]; then
                    net_status="Net up"
                    break
                fi
            fi
        fi
    done
    echo "$net_status"
}

while true; do
    CPU_FREQ=$(get_cpu_freq)
    if [ -f "/sys/class/thermal/thermal_zone0/temp" ]; then
        CPU_TEMP=$(($(cat /sys/class/thermal/thermal_zone0/temp) / 1000))
        CPU_OUT="CPU $CPU_FREQ - $CPU_TEMP°C"
    else
        CPU_OUT="CPU $CPU_FREQ"
    fi

    BAT_DIR="/sys/class/power_supply/BAT0"
    if [ -d "$BAT_DIR" ]; then
        BAT_CAP=$(cat "$BAT_DIR/capacity")
        BAT_STAT=$(cat "$BAT_DIR/status")
        if [ "$BAT_STAT" = "Charging" ]; then
            BAT_OUT="Bat $BAT_CAP% +"
        else
            BAT_OUT="Bat $BAT_CAP%"
        fi
    else
        BAT_OUT="Bat N/A"
    fi

    VOL_OUT=$(get_volume)

    NET_OUT=$(get_network_status)

    DATE_OUT=$(date +'%a %d %b - %I:%M %p ')

    echo "$CPU_OUT : $VOL_OUT : $NET_OUT : $BAT_OUT : $DATE_OUT"

    sleep 1
done
