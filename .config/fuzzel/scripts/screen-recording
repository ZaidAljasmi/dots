#!/bin/sh
OUT_DIR="$HOME/Videos/Recordings"
PID_FILE="/tmp/wf-recorder.pid"
VIDEO_FILE="/tmp/wf-recorder.file"

start_recording() {
    while true; do
        MODE=$(
            printf '%s\n' \
                "Full Screen" \
                "Area Selection" |
            fuzzel -d -p "Screen-Recording: " --placeholder ""
        )

        [ -z "$MODE" ] && exit 0

        AUDIO=$(
            printf '%s\n' \
                "With Audio" \
                "Without Audio" \
                "Back" |
            fuzzel -d -p "Audio: " --placeholder ""
        )

        [ -z "$AUDIO" ] && exit 0
        [ "$AUDIO" = "Back" ] && continue

        break
    done

    mkdir -p "$OUT_DIR" || exit 1
    TIMESTAMP=$(date '+%Y-%m-%d_%H-%M-%S')
    OUT_FILE="$OUT_DIR/recording_$TIMESTAMP.mp4"

    AUDIO_FLAG=""
    [ "$AUDIO" = "With Audio" ] && AUDIO_FLAG="--audio"

    case "$MODE" in
        "Full Screen")
            wf-recorder $AUDIO_FLAG -f "$OUT_FILE" &
            ;;
        "Area Selection")
            GEOMETRY=$(slurp) || exit 1
            wf-recorder $AUDIO_FLAG -g "$GEOMETRY" -f "$OUT_FILE" &
            ;;
    esac

    echo "$!" > "$PID_FILE"
    echo "$OUT_FILE" > "$VIDEO_FILE"
    notify-send "Recording" "Started ($MODE, $AUDIO)"
}

stop_recording() {
    [ -f "$PID_FILE" ] || exit 1
    [ -f "$VIDEO_FILE" ] || exit 1

    PID=$(cat "$PID_FILE")
    OUT_FILE=$(cat "$VIDEO_FILE")

    ACTION=$(
        printf '%s\n' \
            "Keep Video" \
            "Delete Video" |
        fuzzel -d -p "Action: " --placeholder ""
    )

    [ -z "$ACTION" ] && exit 0

    sleep 0.5

    kill -INT "$PID" 2>/dev/null
    while kill -0 "$PID" 2>/dev/null; do
        sleep 0.2
    done

    case "$ACTION" in
        "Keep Video")
            notify-send "Recording" "Saved: $(basename "$OUT_FILE")"
            ;;
        *)
            rm -f "$OUT_FILE"
            notify-send "Recording" "Deleted"
            ;;
    esac

    rm -f "$PID_FILE" "$VIDEO_FILE"
}

main() {
    if [ -f "$PID_FILE" ]; then
        stop_recording
    else
        start_recording
    fi
}

main "$@"
